# Stripe price ID — get from https://dashboard.stripe.com/products
# Create a recurring product (e.g. "Freedly Premium" £4.99/month) and copy the price ID
STRIPE_PRICE_ID=price_your_price_id_here

# App URL
NEXT_PUBLIC_APP_URL=https://usefreedly.com
