{
  "manifest_version": 3,
  "name": "YouTube Side by Side",
  "version": "0.1.0",
  "description": "Watch two YouTube videos side by side in a Chrome side panel.",
  "permissions": ["sidePanel", "declarativeNetRequest", "contextMenus"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open YouTube Side Panel"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_youtube",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com https://consent.youtube.com"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-subsort.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
