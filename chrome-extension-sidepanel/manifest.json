{
  "manifest_version": 3,
  "name": "YouTube Side by Side",
  "version": "0.1.0",
  "description": "Watch two YouTube videos side by side in a Chrome side panel.",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open YouTube Side Panel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
  },
  "icons": {}
}
