{
  "manifest_version": 3,
  "name": "Subscrub",
  "version": "0.2.0",
  "description": "Subscrub Chrome extension — Split View and Stash for YouTube videos.",
  "permissions": ["sidePanel", "declarativeNetRequest", "contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "https://eaubvwmofgydqtmwtkmp.supabase.co/*",
    "https://subsort-git-dev-deanshorters-projects.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Subscrub"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_youtube",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com https://consent.youtube.com https://www.google.com https://google.com"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost:3000/*", "http://localhost:3001/*", "http://127.0.0.1:3000/*", "https://*.vercel.app/*"],
      "js": ["content-subsort.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://subsort-git-dev-deanshorters-projects.vercel.app/*"],
      "js": ["content-auth.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
